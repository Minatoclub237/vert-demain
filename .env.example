# Mesure d'audience Umami (sans cookie). Copier dans .env.local en local, et dans
# Vercel > Settings > Environment Variables pour la production.
# Identifiant du site : Umami Cloud > Settings > Websites > Edit > Website ID.
VITE_UMAMI_ID=
# Facultatif : adresse du script (instance auto-hébergée, ou région UE d'Umami Cloud).
VITE_UMAMI_SRC=
